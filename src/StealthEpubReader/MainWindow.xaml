<Window x:Class="StealthEpubReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title=" HostProcess"
        Width="640" Height="210"
        MinWidth="220" MinHeight="38"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 極簡偽裝按鈕樣式 -->
        <Style x:Key="StealthBtn" TargetType="Button">
            <Setter Property="Background" Value="#18888888" />
            <Setter Property="Foreground" Value="#CC999999" />
            <Setter Property="BorderBrush" Value="#33888888" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44888888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外層主容器（負責控制背景獨立透明度與滑鼠移開自動隱形） -->
    <Border x:Name="RootBorder"
            CornerRadius="3"
            BorderThickness="1"
            BorderBrush="#22888888">

        <Grid x:Name="MainContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 頂部極簡偽裝狀態/控制列（平時微淡，滑鼠移入時變清晰） -->
            <Border x:Name="TopMicroBar"
                    Grid.Row="0"
                    Background="#10000000"
                    Padding="6,2"
                    Opacity="0.40"
                    MouseEnter="TopMicroBar_MouseEnter"
                    MouseLeave="TopMicroBar_MouseLeave">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左側功能按鈕 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnLibrary" Style="{StaticResource StealthBtn}" Content="書庫" ToolTip="開啟極簡書庫 (Ctrl+B / 支援直接拖放 .epub)" Click="BtnLibrary_Click" />
                        <Button x:Name="BtnToc" Style="{StaticResource StealthBtn}" Content="目錄" ToolTip="章節跳轉目錄 (Ctrl+T)" Click="BtnToc_Click" />
                        <Button x:Name="BtnPrevChapter" Style="{StaticResource StealthBtn}" Content="◀" ToolTip="上一章 ( [ )" Click="BtnPrevChapter_Click" />
                        <Button x:Name="BtnNextChapter" Style="{StaticResource StealthBtn}" Content="▶" ToolTip="下一章 ( ] )" Click="BtnNextChapter_Click" />
                    </StackPanel>

                    <!-- 中間進度與狀態顯示（可按住拖曳視窗） -->
                    <TextBlock x:Name="StatusTextBlock"
                               Grid.Column="1"
                               Text="載入中..."
                               FontSize="11"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="按住滑鼠左鍵可任意拖曳視窗；雙擊阅读區可隱藏/顯示此工具列" />

                    <!-- 右側偽裝與設定控制 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnAutoHideToggle" Style="{StaticResource StealthBtn}" Content="自動隱形:關" ToolTip="開啟後，滑鼠移開視窗即自動變為 0% 完全透明" Click="BtnAutoHideToggle_Click" />
                        <Button x:Name="BtnSettings" Style="{StaticResource StealthBtn}" Content="字型/外觀" ToolTip="調整字型、顏色、背景與文字透明度 (Ctrl+,)" Click="BtnSettings_Click" />
                        <Button x:Name="BtnBossHide" Style="{StaticResource StealthBtn}" Content="隱" ToolTip="瞬間隱藏視窗 (預設老闆鍵 Alt+Q)" Click="BtnBossHide_Click" />
                        <Button x:Name="BtnClose" Style="{StaticResource StealthBtn}" Content="✕" ToolTip="儲存進度並關閉程式" Click="BtnClose_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 核心閱讀區（無捲軸、支援任意滾輪手勢與拖曳） -->
            <ScrollViewer x:Name="ReaderScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          PreviewMouseWheel="ReaderScrollViewer_PreviewMouseWheel"
                          ScrollChanged="ReaderScrollViewer_ScrollChanged"
                          MouseDoubleClick="ReaderScrollViewer_MouseDoubleClick">
                <TextBlock x:Name="ReaderTextBlock"
                           TextWrapping="Wrap"
                           Padding="14,6,14,14"
                           FontSize="15"
                           LineStackingStrategy="BlockLineHeight"
                           LineHeight="24" />
            </ScrollViewer>

            <!-- 抽屜面板 1：極簡無封面圖書館與章節目錄 (Library & TOC) -->
            <Border x:Name="LibraryDrawer"
                    Grid.Row="0" Grid.RowSpan="2"
                    Background="#F21E1E1E"
                    BorderBrush="#55888888"
                    BorderThickness="1"
                    Padding="10"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 頂部切換列 -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnTabBooks" Style="{StaticResource StealthBtn}" Content="📚 書庫清單" FontWeight="Bold" Click="BtnTabBooks_Click" />
                            <Button x:Name="BtnTabChapters" Style="{StaticResource StealthBtn}" Content="📑 本書章節 (TOC)" Click="BtnTabChapters_Click" />
                            <Button x:Name="BtnImportEpub" Style="{StaticResource StealthBtn}" Content="+ 匯入 EPUB" Margin="10,0,2,0" Click="BtnImportEpub_Click" />
                            <Button x:Name="BtnRemoveBook" Style="{StaticResource StealthBtn}" Content="- 移除選取" Click="BtnRemoveBook_Click" />
                        </StackPanel>
                        <Button Style="{StaticResource StealthBtn}" Content="返回閱讀 (Esc)" HorizontalAlignment="Right" Click="BtnCloseDrawer_Click" />
                    </Grid>

                    <!-- 關鍵字即時過濾 -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="搜尋：" Foreground="#BBBBBB" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" />
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Background="#2A2D2E"
                                 Foreground="#DDDDDD"
                                 BorderBrush="#44888888"
                                 Padding="4,2"
                                 FontSize="12"
                                 TextChanged="SearchBox_TextChanged" />
                    </Grid>

                    <!-- 書庫清單 ListBox -->
                    <ListBox x:Name="BooksListBox"
                             Grid.Row="2"
                             Background="#181818"
                             Foreground="#CCCCCC"
                             BorderBrush="#33888888"
                             MouseDoubleClick="BooksListBox_MouseDoubleClick"
                             KeyDown="BooksListBox_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#CCCCCC" />
                                        <TextBlock Text=" — " Foreground="#777777" />
                                        <TextBlock Text="{Binding Author}" Foreground="#888888" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressDisplay}" Foreground="#6A9955" FontSize="11" Margin="14,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding LastReadDisplay}" Foreground="#666666" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 章節目錄 ListBox -->
                    <ListBox x:Name="ChaptersListBox"
                             Grid.Row="2"
                             Background="#181818"
                             Foreground="#CCCCCC"
                             BorderBrush="#33888888"
                             Visibility="Collapsed"
                             MouseDoubleClick="ChaptersListBox_MouseDoubleClick"
                             KeyDown="ChaptersListBox_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Padding="2,2" Foreground="#CCCCCC" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 底部操作提示 -->
                    <DockPanel Grid.Row="3" Margin="0,6,0,0">
                        <TextBlock Text="提示：雙擊項目或按 Enter 立即切換；亦可直接把 .epub 檔案拖曳進視窗匯入。"
                                   Foreground="#888888" FontSize="11" VerticalAlignment="Center" />
                        <Button Style="{StaticResource StealthBtn}" Content="切換至選取項目" HorizontalAlignment="Right" Click="BtnConfirmSelection_Click" />
                    </DockPanel>
                </Grid>
            </Border>

            <!-- 抽屜面板 2：字型、雙層透明度與保護色設定 (Appearance & Stealth Settings) -->
            <Border x:Name="SettingsDrawer"
                    Grid.Row="0" Grid.RowSpan="2"
                    Background="#F51E1E1E"
                    BorderBrush="#55888888"
                    BorderThickness="1"
                    Padding="10"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="⚙ 外觀、字型、雙層透明度與防抓包設定" Foreground="#CCCCCC" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                        <Button Style="{StaticResource StealthBtn}" Content="完成返回 (Esc)" HorizontalAlignment="Right" Click="BtnCloseDrawer_Click" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 1. 一鍵保護色主題預設集 -->
                            <TextBlock Text="【上班保護色預設集（一鍵套用）】" Foreground="#9CDCFE" FontSize="11" Margin="0,2,0,4" />
                            <WrapPanel x:Name="PresetButtonsPanel" Margin="0,0,0,8" />

                            <!-- 2. 字型、字體大小與行距 -->
                            <TextBlock Text="【字型與排版（支援所有 Windows 系統字型）】" Foreground="#9CDCFE" FontSize="11" Margin="0,2,0,4" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="系統字型：" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" />
                                <ComboBox x:Name="FontFamilyCombo"
                                          Grid.Column="1"
                                          Height="24"
                                          FontSize="12"
                                          SelectionChanged="FontFamilyCombo_SelectionChanged" />
                                <TextBlock Grid.Column="2" Text="  字體大小：" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" />
                                <DockPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="FontSizeValueText" Text="15pt" Foreground="#CCCCCC" FontSize="11" Width="34" DockPanel.Dock="Right" TextAlignment="Right" />
                                    <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="36" SmallChange="1" LargeChange="2" ValueChanged="FontSizeSlider_ValueChanged" />
                                </DockPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="行距倍數：" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" />
                                <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LineHeightValueText" Text="1.6x" Foreground="#CCCCCC" FontSize="11" Width="34" DockPanel.Dock="Right" TextAlignment="Right" />
                                    <Slider x:Name="LineHeightSlider" Minimum="1.1" Maximum="2.6" SmallChange="0.05" LargeChange="0.2" ValueChanged="LineHeightSlider_ValueChanged" />
                                </DockPanel>
                                <TextBlock Grid.Column="2" Text="  滾輪步進：" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" />
                                <DockPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="ScrollStepValueText" Text="48px" Foreground="#CCCCCC" FontSize="11" Width="38" DockPanel.Dock="Right" TextAlignment="Right" />
                                    <Slider x:Name="ScrollStepSlider" Minimum="16" Maximum="160" SmallChange="8" LargeChange="24" ValueChanged="ScrollStepSlider_ValueChanged" />
                                </DockPanel>
                            </Grid>

                            <!-- 3. 雙層獨立透明度與自訂色彩 -->
                            <TextBlock Text="【雙層獨立透明度與色彩（背景設 0% 可全透明懸浮，文字依然清晰）】" Foreground="#9CDCFE" FontSize="11" Margin="0,2,0,4" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="85" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="背景透明度：" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" />
                                <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="BgOpacityValueText" Text="85%" Foreground="#CCCCCC" FontSize="11" Width="38" DockPanel.Dock="Right" TextAlignment="Right" />
                                    <Slider x:Name="BgOpacitySlider" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" ValueChanged="BgOpacitySlider_ValueChanged" />
                                </DockPanel>
                                <TextBlock Grid.Column="2" Text="  文字透明度：" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" />
                                <DockPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="TextOpacityValueText" Text="88%" Foreground="#CCCCCC" FontSize="11" Width="38" DockPanel.Dock="Right" TextAlignment="Right" />
                                    <Slider x:Name="TextOpacitySlider" Minimum="0.10" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" ValueChanged="TextOpacitySlider_ValueChanged" />
                                </DockPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="85" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="背景色 HEX：" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" />
                                <TextBox x:Name="BgHexBox" Grid.Column="1" Background="#2A2D2E" Foreground="#DDDDDD" BorderBrush="#44888888" Padding="4,2" FontSize="11" LostFocus="ColorHexBox_LostFocus" KeyDown="ColorHexBox_KeyDown" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,10,0">
                                    <Button Style="{StaticResource StealthBtn}" Content="深灰" Tag="#1E1E1E" Click="QuickBgColor_Click" />
                                    <Button Style="{StaticResource StealthBtn}" Content="純黑" Tag="#0D0D0D" Click="QuickBgColor_Click" />
                                    <Button Style="{StaticResource StealthBtn}" Content="純白" Tag="#FFFFFF" Click="QuickBgColor_Click" />
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="文字色 HEX：" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" />
                                <TextBox x:Name="TextHexBox" Grid.Column="4" Background="#2A2D2E" Foreground="#DDDDDD" BorderBrush="#44888888" Padding="4,2" FontSize="11" LostFocus="ColorHexBox_LostFocus" KeyDown="ColorHexBox_KeyDown" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="4,0,0,0">
                                    <Button Style="{StaticResource StealthBtn}" Content="註解綠" Tag="#6A9955" Click="QuickTextColor_Click" />
                                    <Button Style="{StaticResource StealthBtn}" Content="暗灰" Tag="#858585" Click="QuickTextColor_Click" />
                                    <Button Style="{StaticResource StealthBtn}" Content="深灰字" Tag="#4A4A4A" Click="QuickTextColor_Click" />
                                </StackPanel>
                            </Grid>

                            <!-- 4. 防抓包與老闆鍵設定 -->
                            <TextBlock Text="【防抓包與全域老闆鍵】" Foreground="#9CDCFE" FontSize="11" Margin="0,2,0,4" />
                            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,4">
                                <TextBlock Text="全域老闆鍵：" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ComboBox x:Name="BossKeyCombo" Width="100" Height="22" FontSize="11" Margin="0,0,14,0" SelectionChanged="BossKeyCombo_SelectionChanged" />
                                <CheckBox x:Name="AutoHideCheckBox" Content="滑鼠移開視窗自動 0% 透明隱形" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" Checked="StealthCheckBox_Changed" Unchecked="StealthCheckBox_Changed" />
                                <CheckBox x:Name="TopmostCheckBox" Content="視窗永遠置頂" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" Checked="StealthCheckBox_Changed" Unchecked="StealthCheckBox_Changed" />
                                <CheckBox x:Name="HideAltTabCheckBox" Content="從 Alt+Tab 清單中隱藏" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" Checked="StealthCheckBox_Changed" Unchecked="StealthCheckBox_Changed" />
                            </WrapPanel>

                            <TextBlock Text="快捷鍵總覽：[Alt+Q] 老闆鍵瞬隱/喚醒 · [Ctrl+滾輪] 縮放字體 · [Alt+滾輪] 調整文字透明度 · [Shift+滾輪] 調整背景透明度 · [上下鍵/滾輪] 逐行捲動 · [左右鍵/空白鍵] 翻頁與跨章 · [雙擊內文] 隱藏頂部微工具列"
                                       Foreground="#777777" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右下角極低調縮放控制點 -->
            <ResizeGrip Grid.Row="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Opacity="0.25"
                        Cursor="SizeNWSE" />
        </Grid>
    </Border>
</Window>
